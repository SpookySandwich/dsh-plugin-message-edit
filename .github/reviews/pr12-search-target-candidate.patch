+test('a hidden content hit opens its matching version regardless of remembered sibling or rememberPath setting', async () => {
+  for (const rememberPath of [true, false]) {
+    const h = setup({ foldSidebar: true, rememberPath });
+    h.list.byId.child.retainedBy = {};
+    h.list.byId.nested.retainedBy = { mainView: 1 };
+    h.workspace.archivedSessionIds = [];
+    const props = h.render();
+    const result = await props.searchSessions('only child content');
+    const match = result.items[0];
+    assert.equal(match.sessionId, 'child');
+    assert.equal(props.useSessions(state => state.byId[match.sessionId]), h.list.byId.child,
+      'native search must be able to resolve the hidden version');
+    props.open(match.sessionId);
+    props.open('root');
+    assert.deepEqual(h.opens, ['child', rememberPath ? 'nested' : 'root']);
+  }
+});
